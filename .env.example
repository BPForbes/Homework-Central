# Copy this file to .env and fill in the values before running docker-compose.
# Never commit .env to source control.
# scripts/run-dev.* and scripts/reset-dev-db.* auto-generate JWT_SECRET and FCAPTCHA_SECRET
# into .env (local only). reset-dev-db rolls FCAPTCHA_SECRET each time.

# JWT signing secret — must be at least 32 characters, cryptographically random.
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# PostgreSQL — local dev uses fixed credentials (postgres / postgres)
POSTGRES_PASSWORD=postgres

# Host port for Docker Postgres (maps to container 5432).
# Default 5434 avoids conflict with local PostgreSQL installs on 5432/5433.
POSTGRES_HOST_PORT=5434

# FCaptcha shared secret — must match the fcaptcha container and backend FCaptcha__Secret.
# Generate with: openssl rand -base64 48
FCAPTCHA_SECRET=replace-with-a-long-random-secret

# Host port for Docker FCaptcha (maps to container 3000).
FCAPTCHA_HOST_PORT=3010

# Dev cluster environment label stored on tenant registry rows.
TENANCY_CLUSTER_ENVIRONMENT=dev

# ---------------------------------------------------------------------------
# Docker memory budget
# ---------------------------------------------------------------------------
# Every compose service is capped so the Docker VM cannot quietly grow to fill the
# machine. Defaults total ~1 GiB across all four services (~384 MiB for the two that
# the dev scripts actually start). Raise a value only if that service is being
# OOM-killed; `docker stats` shows the live usage against these limits.
POSTGRES_MEM_LIMIT=256m
POSTGRES_CPUS=1.0

FCAPTCHA_MEM_LIMIT=128m
FCAPTCHA_CPUS=1.0
# Soft ceiling for the Go runtime's heap — keep it comfortably below FCAPTCHA_MEM_LIMIT.
FCAPTCHA_GO_MEM_LIMIT=96MiB
FCAPTCHA_GOGC=50
FCAPTCHA_GOMAXPROCS=2

# Only used by `docker compose --profile app up` — the dev scripts run the API and the
# frontend natively instead, which costs no container memory at all.
BACKEND_MEM_LIMIT=512m
BACKEND_CPUS=2.0
FRONTEND_MEM_LIMIT=64m
FRONTEND_CPUS=0.5
